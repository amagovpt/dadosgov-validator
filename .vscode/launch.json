{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Docker (Flask)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ]
        },
        {
            "name": "Attach to Docker (Celery)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5679
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/app"
                }
            ]
        }
    ],
    "compounds": [
        {
            "name": "Flask + Celery",
            "configurations": [
                "Attach to Docker (Flask)",
                "Attach to Docker (Celery)"
            ]
        }
    ]
}