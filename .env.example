# Copiar para .env e preencher. O .env real esta ignorado pelo git.

FLASK_APP=run.py
FLASK_ENV=development

# Usada pelo Flask para assinar sessoes. Obrigatorio definir em producao.
SECRET_KEY=<gerar-uma-chave-aleatoria>

# Broker e backend do Celery
REDIS_URL=redis://localhost:6379/0

DATABASE_URL=postgresql://<user>:<password>@localhost:5432/dataset_validation

# API do dados.gov. A X-API-KEY nao se configura aqui: e enviada no pedido.
DADOSGOV_API_BASE_URL=https://ppr-dadosgov.arte.gov.pt
DADOSGOV_API_TIMEOUT_SECONDS=15

UPLOAD_FOLDER=uploads

# 500 MB em bytes
MAX_CONTENT_LENGTH=524288000

# 30 minutos em segundos
DATAFRAME_STORE_REMOVAL_TIMEOUT=1800
